        "_brand_page": {
          "version": 3,
          "body": "<style>\n  :root{--ink:#0b0b0c;--ink-2:#16171a;--ink-3:#202226;--line:rgba(255,255,255,.14);--line-soft:rgba(255,255,255,.08);--neon:#b8ff3d;--neon-dim:#8fd42a;--paper:#f2f3ef;--muted:#a2a5a9;--muted-2:#7c8085;--radius:22px}\n  *{box-sizing:border-box}\n  html{-webkit-text-size-adjust:100%}\n  body{margin:0;background:var(--ink);color:var(--paper);font-family:\"Helvetica Neue\",Helvetica,Arial,\"PingFang SC\",\"Hiragino Sans GB\",\"Microsoft YaHei\",sans-serif;font-size:16px;line-height:1.7;letter-spacing:.01em}\n  a{color:inherit}\n  h1,h2,h3,p,ul,ol,dl,dd{margin:0}\n  ul,ol{padding:0;list-style:none}\n  .wrap{width:100%;max-width:1180px;margin:0 auto;padding:0 22px}\n  .neon{color:var(--neon)}\n  .rule{height:1px;background:var(--line-soft);border:0;margin:0}\n\n  /* ---------- HERO ---------- */\n  .hero{border-bottom:1px solid var(--line-soft);padding:34px 0 60px;background:\n      radial-gradient(900px 420px at 88% -10%, rgba(184,255,61,.10), transparent 65%),\n      var(--ink)}\n  .hero-top{display:flex;align-items:baseline;justify-content:space-between;gap:18px;flex-wrap:wrap;margin-bottom:38px}\n  .brandmark{font-size:15px;font-weight:700;letter-spacing:.34em;text-transform:uppercase}\n  .brandmark span{color:var(--neon)}\n  .stamp{font-size:12px;letter-spacing:.18em;color:var(--muted-2);text-transform:uppercase}\n  .anchors{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:44px}\n  .anchors a{display:inline-block;text-decoration:none;font-size:13px;letter-spacing:.06em;padding:7px 15px;border:1px solid var(--line);border-radius:999px;color:#d9dbd6;transition:background .18s ease,color .18s ease,border-color .18s ease}\n  .anchors a:hover,.anchors a:focus{background:var(--neon);color:#0b0b0c;border-color:var(--neon)}\n\n  .masthead{display:grid;grid-template-columns:1.35fr .95fr;gap:20px 56px;align-items:start}\n  .masthead .col-a{grid-row:span 3}\n  .kicker{font-size:12px;letter-spacing:.24em;text-transform:uppercase;color:var(--neon);margin-bottom:18px}\n  h1{font-size:clamp(46px,9vw,104px);line-height:.92;letter-spacing:-.03em;font-weight:800;margin-bottom:26px}\n  h1 em{font-style:normal;color:var(--neon)}\n  .lede{font-size:clamp(17px,2vw,20px);color:#c8cbc4;max-width:34em}\n  .pullquote{border-left:2px solid var(--neon);padding:4px 0 4px 20px;font-size:17px;line-height:1.65;color:#dfe1da}\n  .pullquote cite{display:block;margin-top:12px;font-style:normal;font-size:12px;letter-spacing:.16em;color:var(--muted-2);text-transform:uppercase}\n  .factlist{border-top:1px solid var(--line);margin-top:6px}\n  .factlist div{display:grid;grid-template-columns:96px 1fr;gap:12px;padding:14px 0;border-bottom:1px solid var(--line-soft)}\n  .factlist dt{font-size:12px;letter-spacing:.14em;color:var(--muted-2);text-transform:uppercase;padding-top:3px}\n  .factlist dd{font-size:15px;color:#e6e8e1}\n  .note{margin-top:16px;font-size:13px;color:var(--muted-2)}\n\n  /* ---------- SECTION SHELL ---------- */\n  section.block{padding:64px 0}\n  .block-head{display:grid;grid-template-columns:auto 1fr;gap:8px 26px;align-items:baseline;margin-bottom:34px}\n  .block-head .num{font-size:12px;letter-spacing:.2em;color:var(--neon);border:1px solid var(--line);border-radius:999px;padding:3px 12px;white-space:nowrap}\n  h2{font-size:clamp(24px,3.6vw,34px);line-height:1.25;letter-spacing:-.01em;font-weight:700}\n  .sub{grid-column:2;color:var(--muted);font-size:15px;max-width:48em;margin-top:2px}\n\n  /* ---------- STEPS ---------- */\n  .steps{display:grid;grid-template-columns:repeat(4,1fr);gap:18px}\n  .step{background:var(--ink-2);border-radius:var(--radius);padding:26px 22px 28px;box-shadow:0 18px 40px -28px rgba(0,0,0,.95), inset 0 1px 0 rgba(255,255,255,.04)}\n  .step .idx{font-size:13px;letter-spacing:.18em;color:var(--neon);margin-bottom:16px;display:block}\n  .step h3{font-size:17px;line-height:1.4;margin-bottom:10px;font-weight:700}\n  .step p{font-size:14px;color:var(--muted);line-height:1.72}\n\n  /* ---------- PLANS TABLE ---------- */\n  .table-scroll{overflow-x:auto;-webkit-overflow-scrolling:touch;border-radius:var(--radius)}\n  table{width:100%;border-collapse:separate;border-spacing:0;min-width:760px;background:var(--ink-2);border-radius:var(--radius);overflow:hidden;box-shadow:0 24px 60px -40px rgba(0,0,0,1);font-size:14px}\n  caption{text-align:left;color:var(--muted-2);font-size:13px;padding:0 0 14px;letter-spacing:.04em}\n  th,td{text-align:left;padding:18px 20px;vertical-align:top;border-bottom:1px solid var(--line-soft)}\n  thead th{background:var(--ink-3);font-size:13px;letter-spacing:.14em;text-transform:uppercase;color:#cfd2ca;border-bottom:1px solid var(--line);vertical-align:bottom}\n  thead th .plan-name{display:block;font-size:19px;letter-spacing:0;text-transform:none;color:var(--paper);margin-bottom:6px;font-weight:700}\n  thead th .plan-price{display:block;font-size:14px;letter-spacing:0;text-transform:none;color:var(--neon);font-weight:700}\n  thead th .plan-annual{display:block;font-size:12px;letter-spacing:0;text-transform:none;color:var(--muted-2);margin-top:4px;font-weight:400}\n  thead th.featured{background:linear-gradient(180deg,rgba(184,255,61,.13),rgba(184,255,61,.02))}\n  thead th.featured .plan-name::after{content:\"推荐\";display:inline-block;margin-left:10px;font-size:11px;letter-spacing:.14em;background:var(--neon);color:#0b0b0c;padding:2px 8px;border-radius:999px;vertical-align:2px}\n  tbody th{font-weight:400;color:var(--muted);width:150px;font-size:13px;letter-spacing:.06em}\n  tbody td{color:#e3e5de}\n  tbody tr:last-child th,tbody tr:last-child td{border-bottom:0}\n  tbody td.featured{background:rgba(184,255,61,.05)}\n  .ok{color:var(--neon);font-weight:700;margin-right:8px}\n  .dash{color:var(--muted-2)}\n  .table-note{margin-top:16px;font-size:13px;color:var(--muted-2);line-height:1.75}\n\n  /* ---------- TONES / CARD GRID ---------- */\n  .cards{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}\n  .card{background:var(--ink-2);border-radius:var(--radius);padding:28px 24px;box-shadow:0 18px 40px -28px rgba(0,0,0,.95), inset 0 1px 0 rgba(255,255,255,.04)}\n  .card h3{font-size:18px;margin-bottom:10px;font-weight:700}\n  .card p{font-size:14px;color:var(--muted);line-height:1.75}\n  .card .tag{display:inline-block;font-size:11px;letter-spacing:.18em;text-transform:uppercase;color:var(--neon-dim);margin-bottom:14px}\n\n  /* ---------- CLIENTS ---------- */\n  .clients{display:grid;grid-template-columns:1fr 1fr;gap:18px}\n  .client{background:var(--ink-2);border-radius:var(--radius);padding:26px 24px;box-shadow:0 18px 40px -28px rgba(0,0,0,.95), inset 0 1px 0 rgba(255,255,255,.04);display:flex;flex-direction:column;gap:12px}\n  .client h3{font-size:18px;font-weight:700;display:flex;align-items:center;gap:10px;flex-wrap:wrap}\n  .client .badge{font-size:11px;letter-spacing:.16em;text-transform:uppercase;color:var(--muted-2);border:1px solid var(--line);border-radius:999px;padding:2px 9px;font-weight:400}\n  .client p{font-size:14px;color:var(--muted);line-height:1.75}\n  .client .status{margin-top:auto;font-size:13px;color:#cfd2ca;border-top:1px solid var(--line-soft);padding-top:12px}\n  .client .status strong{color:var(--neon);font-weight:700}\n  .client a{align-self:flex-start;font-size:13px;text-decoration:none;color:#0b0b0c;background:var(--neon);padding:8px 16px;border-radius:999px;font-weight:700}\n  .client a:hover,.client a:focus{background:#cdff78}\n\n  /* ---------- FAQ ---------- */\n  .faq{display:grid;grid-template-columns:1fr 1fr;gap:26px 40px}\n  .qa{border-top:1px solid var(--line);padding-top:18px}\n  .qa h3{font-size:16px;line-height:1.55;font-weight:700;margin-bottom:8px}\n  .qa h3::before{content:\"Q\";color:var(--neon);font-weight:800;margin-right:9px;font-size:13px;letter-spacing:.06em}\n  .qa p{font-size:14px;color:#b9bcb5;line-height:1.8}\n  .qa p::before{content:\"A\";color:var(--muted-2);font-weight:700;margin-right:9px;font-size:13px;letter-spacing:.06em}\n\n  /* ---------- FOOTER ---------- */\n  footer{border-top:1px solid var(--line-soft);padding:36px 0 60px;background:var(--ink)}\n  .foot{display:grid;grid-template-columns:1fr auto;gap:16px 30px;align-items:start}\n  .foot strong{letter-spacing:.3em;font-size:14px;text-transform:uppercase}\n  .foot p{font-size:13px;color:var(--muted-2);line-height:1.8;max-width:52em;margin-top:10px}\n  .foot .mini{display:flex;gap:16px;flex-wrap:wrap;font-size:13px}\n  .foot .mini a{text-decoration:none;color:#cfd2ca;border-bottom:1px solid var(--line);padding-bottom:2px}\n  .foot .mini a:hover,.foot .mini a:focus{color:var(--neon);border-color:var(--neon)}\n\n  /* ---------- RESPONSIVE ---------- */\n  @media (max-width:980px){.masthead{grid-template-columns:1fr;gap:26px}\n    .masthead .col-a{grid-row:auto}\n    .steps{grid-template-columns:1fr 1fr}\n    .cards{grid-template-columns:1fr}}\n  @media (max-width:720px){\n    .hero{padding:26px 0 46px}\n    .hero-top{margin-bottom:26px}\n    .anchors{margin-bottom:30px}\n    section.block{padding:48px 0}\n    .steps{grid-template-columns:1fr}\n    .clients{grid-template-columns:1fr}\n    .faq{grid-template-columns:1fr;gap:22px}\n    .block-head{grid-template-columns:1fr}\n    .block-head .num{justify-self:start}\n    .sub{grid-column:1}\n    .factlist div{grid-template-columns:84px 1fr}\n    .foot{grid-template-columns:1fr}\n    table{font-size:13px}\n    th,td{padding:15px 16px}\n  }\n</style><header class=\"hero\">\n  <div class=\"wrap\">\n    <div class=\"hero-top\">\n      <div class=\"brandmark\">T<span>T</span></div>\n      <div class=\"stamp\">订阅说明 · 使用指南 · 常见问题</div>\n    </div>\n\n    <nav class=\"anchors\" aria-label=\"页面锚点\">\n      <a href=\"#usage\">使用步骤</a>\n      <a href=\"#plans\">订阅方案</a>\n      <a href=\"#clients\">客户端</a>\n      <a href=\"#faq\">常见问题</a>\n    </nav>\n\n    <div class=\"masthead\">\n      <div class=\"col-a\">\n        <p class=\"kicker\">TT 订阅体系</p>\n        <h1>TT · 三档订阅，<br><em>边界清楚。</em></h1>\n        <p class=\"lede\">TT 把订阅拆成三件事：每月流量、设备额度、节点范围。先看数字，再看价格。不打包模糊承诺，也不在细则里藏条件。</p>\n      </div>\n\n      <div class=\"pullquote\">\n        选套餐不该靠感觉。把每月要用多少流量、几台设备同时在线写下来，剩下的就是对照表格找一行。\n        TT 编辑说明\n      </div>\n\n      <dl class=\"factlist\">\n        <div>\n          <dt>方案</dt>\n          <dd>基础版 / 旗舰版 / 团队版</dd>\n        </div>\n        <div>\n          <dt>计费</dt>\n          <dd>月付与年付两档，年付价格在各档中标出</dd>\n        </div>\n        <div>\n          <dt>核心差异</dt>\n          <dd>流量额度、同时在线设备数、节点与支持等级</dd>\n        </div>\n      </dl>\n\n      <p class=\"note\">页面所列价格与权益为当前展示口径，最终以实际订购页面显示为准。</p>\n    </div>\n  </div>\n</header>\n\n<main>\n\n  <section class=\"block\" id=\"usage\">\n    <div class=\"wrap\">\n      <div class=\"block-head\">\n        <span class=\"num\">01 使用步骤</span>\n        <h2>四步走完，从选择到日常使用</h2>\n        <p class=\"sub\">流程本身不复杂，容易出错的地方通常在第一和第四步：先确认额度够不够，再确认设备上的配置是否生效。</p>\n      </div>\n\n      <div class=\"steps\">\n        <article class=\"step\">\n          <span class=\"idx\">STEP 01</span>\n          <h3>先算需求</h3>\n          <p>写下三件事：每月大概用多少流量、同时在线几台设备、是否需要流媒体或游戏线路。这三项决定你落在哪一档。</p>\n        </article>\n        <article class=\"step\">\n          <span class=\"idx\">STEP 02</span>\n          <h3>对照表格选档</h3>\n          <p>打开订阅方案表格，逐行比对。只比价格容易选错，重点看流量与设备数量两行是否覆盖你的最高使用量。</p>\n        </article>\n        <article class=\"step\">\n          <span class=\"idx\">STEP 03</span>\n          <h3>完成订购</h3>\n          <p>按所选档位与计费周期下单。年付折算到每月更便宜，但需要一次性付清全年费用，按现金流决定即可。</p>\n        </article>\n        <article class=\"step\">\n          <span class=\"idx\">STEP 04</span>\n          <h3>配置并验证</h3>\n          <p>在常用设备上完成客户端配置，先确认连接状态正常，再逐台添加其他设备，避免一次加满后难以定位问题。</p>\n        </article>\n      </div>\n    </div>\n  </section>\n\n  <hr class=\"rule\">\n\n  <section class=\"block\" id=\"plans\">\n    <div class=\"wrap\">\n      <div class=\"block-head\">\n        <span class=\"num\">02 订阅方案</span>\n        <h2>三档横向对照</h2>\n        <p class=\"sub\">基础版够用，旗舰版覆盖多数人，团队版按设备数量与带宽需求上探。表格中的每一项都可以直接对照。</p>\n      </div>\n\n      <div class=\"table-scroll\">\n        <table>\n          价格与权益对照 · 年付价格按对应档位折算展示\n          <thead>\n            <tr>\n              <th>对比项</th>\n              <th>\n                <span class=\"plan-name\">基础版</span>\n                <span class=\"plan-price\">¥15 / 月</span>\n                <span class=\"plan-annual\">按年付 ¥150 / 年</span>\n              </th>\n              <th class=\"featured\">\n                <span class=\"plan-name\">旗舰版</span>\n                <span class=\"plan-price\">¥35 / 月</span>\n                <span class=\"plan-annual\">按年付 ¥350 / 年</span>\n              </th>\n              <th>\n                <span class=\"plan-name\">团队版</span>\n                <span class=\"plan-price\">¥85 / 月</span>\n                <span class=\"plan-annual\">按年付 ¥850 / 年</span>\n              </th>\n            </tr>\n          </thead>\n          <tbody>\n            <tr>\n              <th>每月流量</th>\n              <td>100GB</td>\n              <td class=\"featured\">300GB</td>\n              <td>1000GB</td>\n            </tr>\n            <tr>\n              <th>同时在线设备</th>\n              <td>3 台</td>\n              <td class=\"featured\">5 台</td>\n              <td>20 台</td>\n            </tr>\n            <tr>\n              <th>节点范围</th>\n              <td>普通线路节点池</td>\n              <td class=\"featured\">全节点，含 IPLC 专线</td>\n              <td>VIP 专属高带宽节点</td>\n            </tr>\n            <tr>\n              <th>流媒体</th>\n              <td>基础流媒体解锁</td>\n              <td class=\"featured\">全节点原生流媒体解锁</td>\n              <td>VIP 节点流媒体支持</td>\n            </tr>\n            <tr>\n              <th>线路优化</th>\n              <td><span class=\"dash\">—</span></td>\n              <td class=\"featured\">IPLC 专线游戏加速优化</td>\n              <td>高带宽线路，支持企业定制路由</td>\n            </tr>\n            <tr>\n              <th>支持方式</th>\n              <td>常规工单</td>\n              <td class=\"featured\">7×24 优先工单</td>\n              <td>专属客户经理</td>\n            </tr>\n            <tr>\n              <th>适合谁</th>\n              <td>个人日常浏览，设备不多</td>\n              <td class=\"featured\">多设备日常使用，兼顾流媒体与游戏</td>\n              <td>小团队协作，统一管理多台设备</td>\n            </tr>\n          </tbody>\n        </table>\n      </div>\n\n      <p class=\"table-note\">年付价格仅在表格中作为计费口径展示，实际结算金额与可用支付方式以订购页面为准。流量按月重置，设备额度指同一时间在线的设备数量上限。</p>\n    </div>\n  </section>\n\n  <hr class=\"rule\">\n\n  <section class=\"block\" id=\"clients\">\n    <div class=\"wrap\">\n      <div class=\"block-head\">\n        <span class=\"num\">03 客户端</span>\n        <h2>按设备选客户端，配置方式一致</h2>\n        <p class=\"sub\">不同设备的客户端不同，但配置步骤相同：填入订阅信息、保存、启用、验证。下面按平台说明适用范围。</p>\n      </div>\n\n      <div class=\"clients\">\n        <article class=\"client\">\n          <h3>桌面端 <span class=\"badge\">Windows / macOS</span></h3>\n          <p>适合长时间使用与多窗口场景。安装后填入订阅信息，保存配置并启用，确认状态显示为已连接后再开始其他操作。</p>\n          <p class=\"status\">获取方式：<strong>以站内说明为准</strong>，下载地址确认后补充。</p>\n          <a href=\"#faq\">查看配置问题</a>\n        </article>\n\n        <article class=\"client\">\n          <h3>移动端 <span class=\"badge\">iOS / Android</span></h3>\n          <p>适合随身使用。安装后按引导填入订阅信息，启用后回到常用应用验证一次，再决定是否允许后台保持连接。</p>\n          <p class=\"status\">获取方式：<strong>以站内说明为准</strong>，下载地址确认后补充。</p>\n          <a href=\"#faq\">查看配置问题</a>\n        </article>\n\n        <article class=\"client\">\n          <h3>路由器与共享设备 <span class=\"badge\">按设备型号适配</span></h3>\n          <p>把连接配置放在路由器上，可让同一网络内的设备共用一条链路。是否支持取决于路由器固件与型号，需先确认再操作。</p>\n          <p class=\"status\">获取方式：<strong>暂无公开下载入口</strong>，请以设备说明为准。</p>\n          <a href=\"#plans\">对照设备额度</a>\n        </article>\n\n        <article class=\"client\">\n          <h3>设备额度说明 <span class=\"badge\">与套餐绑定</span></h3>\n          <p>同时在线设备数由套餐决定：基础版 3 台、旗舰版 5 台、团队版 20 台。超出额度时，需要先下线不用的设备再添加新设备。</p>\n          <p class=\"status\">当前档位：<strong>请在订阅方案中确认</strong>。</p>\n          <a href=\"#plans\">返回方案表</a>\n        </article>\n      </div>\n    </div>\n  </section>\n\n  <hr class=\"rule\">\n\n  <section class=\"block\" id=\"faq\">\n    <div class=\"wrap\">\n      <div class=\"block-head\">\n        <span class=\"num\">04 常见问题</span>\n        <h2>八个先问清楚的问题</h2>\n        <p class=\"sub\">关于计费、流量、设备与配置。答案只写到能确认的部分，不确定的内容不猜测。</p>\n      </div>\n\n      <div class=\"faq\">\n        <article class=\"qa\">\n          <h3>月付和年付差在哪里？</h3>\n          <p>只在计费周期与总额。年付一次性付清全年费用，折算到每月更低：基础版 ¥150/年、旗舰版 ¥350/年、团队版 ¥850/年。权益内容不因计费周期而增加。</p>\n        </article>\n\n        <article class=\"qa\">\n          <h3>流量用完了会怎样？</h3>\n          <p>每档套餐都有明确的每月流量额度：100GB、300GB、1000GB。额度用尽后的处理方式以订购页面说明为准，建议按最高月用量选择档位，留出余量。</p>\n        </article>\n\n        <article class=\"qa\">\n          <h3>设备数量怎么计算？</h3>\n          <p>按同一时间在线的设备数量计算，而不是按累计安装过的设备计算。基础版 3 台、旗舰版 5 台、团队版 20 台。切换设备时先下线旧设备即可。</p>\n        </article>\n\n        <article class=\"qa\">\n          <h3>从基础版升级到旗舰版，需要重新配置吗？</h3>\n          <p>套餐变更后请以订购页面提示为准。通常需要在客户端更新订阅信息并重新保存配置，建议升级后先在一台设备上验证，再同步其他设备。</p>\n        </article>\n\n        <article class=\"qa\">\n          <h3>配置后连不上，先查哪里？</h3>\n          <p>按顺序排查三处：订阅信息是否完整填入、配置是否已保存并启用、当前设备数量是否已超出套餐额度。三项都正常再考虑更换节点尝试。</p>\n        </article>\n\n        <article class=\"qa\">\n          <h3>团队版和旗舰版的区别是不是只有流量？</h3>\n          <p>不止。团队版在流量和在线设备额度上更高，同时提供 VIP 专属高带宽节点、企业定制路由支持与专属客户经理。旗舰版则侧重 IPLC 专线游戏加速与 7×24 优先工单。</p>\n        </article>\n\n        <article class=\"qa\">\n          <h3>客户端从哪里获取？</h3>\n          <p>本页不提供下载直链。桌面端与移动端的获取方式以站内说明为准；路由器等共享设备需先确认固件与型号是否支持，再按设备说明操作。</p>\n        </article>\n\n        <article class=\"qa\">\n          <h3>价格会变吗？以哪个为准？</h3>\n          <p>本页展示的价格与权益为当前口径，可能随方案调整而变化。下单前请以实际订购页面显示的金额与条目为准，两者不一致时以订购页面为准。</p>\n        </article>\n      </div>\n    </div>\n  </section>\n\n</main>\n\n<footer>\n  <div class=\"wrap foot\">\n    <div>\n      <strong>TT</strong>\n      <p>本页为订阅方案与使用说明，用于帮助你在三档方案之间做出对照选择。页面不构成任何性能或可用性承诺，具体权益以订购页面为准。</p>\n    </div>\n    <div class=\"mini\">\n      <a href=\"#usage\">使用步骤</a>\n      <a href=\"#plans\">订阅方案</a>\n      <a href=\"#clients\">客户端</a>\n      <a href=\"#faq\">常见问题</a>\n    </div>\n  </div>\n</footer>",
